# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/nexusflow

# MongoDB Time-Series Telemetry Schema Contract (Configurable to Rishi's specs)
DB_NAME=nexusflow
TELEMETRY_COLLECTION=telemetry
TELEMETRY_TIME_FIELD=timestamp
TELEMETRY_META_FIELD=metadata
TELEMETRY_SENSOR_ID_KEY=sensorId
TELEMETRY_GRANULARITY=seconds
