{
  "info": {
    "name": "NexusFlow Telemetry Ingestion & Reliability API",
    "_postman_id": "nexusflow-telemetry-v2",
    "description": "Day 4 Express Telemetry Ingestion, Bulk Processing, Reliability & Metrics Collection for NexusFlow Visual IoT Telemetry Rule Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check (with Ingestion Stats)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Get Operational Ingestion Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "metrics"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensorId\": \"turbine-sensor-01\",\n  \"sensorType\": \"Turbine Sensor\",\n  \"value\": 1850.5,\n  \"unit\": \"RPM\",\n  \"location\": \"Sector 4\",\n  \"timestamp\": \"2026-11-15T06:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single - Missing sensorId - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 1500,\n  \"unit\": \"RPM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single - Malformed JSON - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensorId\": \"bad-json\",\n  \"value\": invalid_syntax\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Full Success 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"temp-sensor-01\",\n    \"sensorType\": \"Temperature Sensor\",\n    \"value\": 85.6,\n    \"unit\": \"°C\",\n    \"location\": \"Furnace Room\"\n  },\n  {\n    \"sensorId\": \"humidity-sensor-01\",\n    \"sensorType\": \"Humidity Sensor\",\n    \"value\": 62.4,\n    \"unit\": \"%\",\n    \"location\": \"Storage Unit\"\n  },\n  {\n    \"sensorId\": \"turbine-sensor-01\",\n    \"sensorType\": \"Turbine Sensor\",\n    \"value\": 1920.0,\n    \"unit\": \"RPM\",\n    \"location\": \"Turbine Hall\"\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Partial Failure 207 Multi-Status)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"valid-sensor-1\",\n    \"value\": 45.2,\n    \"unit\": \"°C\"\n  },\n  {\n    \"sensorId\": \"\",\n    \"value\": 50.0\n  },\n  {\n    \"sensorId\": \"valid-sensor-2\",\n    \"value\": 88.0,\n    \"unit\": \"RPM\"\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Atomic Mode ?allOrNone=true - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"valid-sensor-1\",\n    \"value\": 45.2\n  },\n  {\n    \"sensorId\": \"\",\n    \"value\": 50.0\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk?allOrNone=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"],
          "query": [
            { "key": "allOrNone", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Empty Batch - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Get Telemetry By Sensor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/turbine-sensor-01?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "turbine-sensor-01"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "startTime", "value": "2026-11-15T00:00:00.000Z", "disabled": true },
            { "key": "endTime", "value": "2026-11-15T23:59:59.000Z", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Latest Telemetry For Sensor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/turbine-sensor-01/latest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "turbine-sensor-01", "latest"]
        }
      }
    }
  ]
}
