{
  "info": {
    "name": "NexusFlow Telemetry Ingestion & Reliability API",
    "_postman_id": "nexusflow-telemetry-v2",
    "description": "Day 4 Express Telemetry Ingestion, Bulk Processing, Reliability & Metrics Collection for NexusFlow Visual IoT Telemetry Rule Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check (with Ingestion Stats)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Get Operational Ingestion Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "metrics"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensorId\": \"turbine-sensor-01\",\n  \"sensorType\": \"Turbine Sensor\",\n  \"value\": 1850.5,\n  \"unit\": \"RPM\",\n  \"location\": \"Sector 4\",\n  \"timestamp\": \"2026-11-15T06:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single - Missing sensorId - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 1500,\n  \"unit\": \"RPM\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Single - Malformed JSON - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensorId\": \"bad-json\",\n  \"value\": invalid_syntax\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Full Success 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"temp-sensor-01\",\n    \"sensorType\": \"Temperature Sensor\",\n    \"value\": 85.6,\n    \"unit\": \"°C\",\n    \"location\": \"Furnace Room\"\n  },\n  {\n    \"sensorId\": \"humidity-sensor-01\",\n    \"sensorType\": \"Humidity Sensor\",\n    \"value\": 62.4,\n    \"unit\": \"%\",\n    \"location\": \"Storage Unit\"\n  },\n  {\n    \"sensorId\": \"turbine-sensor-01\",\n    \"sensorType\": \"Turbine Sensor\",\n    \"value\": 1920.0,\n    \"unit\": \"RPM\",\n    \"location\": \"Turbine Hall\"\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Partial Failure 207 Multi-Status)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"valid-sensor-1\",\n    \"value\": 45.2,\n    \"unit\": \"°C\"\n  },\n  {\n    \"sensorId\": \"\",\n    \"value\": 50.0\n  },\n  {\n    \"sensorId\": \"valid-sensor-2\",\n    \"value\": 88.0,\n    \"unit\": \"RPM\"\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Atomic Mode ?allOrNone=true - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"sensorId\": \"valid-sensor-1\",\n    \"value\": 45.2\n  },\n  {\n    \"sensorId\": \"\",\n    \"value\": 50.0\n  }\n]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk?allOrNone=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"],
          "query": [
            { "key": "allOrNone", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Ingest Telemetry (Bulk - Empty Batch - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[]"
        },
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "bulk"]
        }
      }
    },
    {
      "name": "Get Telemetry By Sensor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/turbine-sensor-01?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "turbine-sensor-01"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "startTime", "value": "2026-11-15T00:00:00.000Z", "disabled": true },
            { "key": "endTime", "value": "2026-11-15T23:59:59.000Z", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Latest Telemetry For Sensor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/telemetry/turbine-sensor-01/latest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "telemetry", "turbine-sensor-01", "latest"]
        }
      }
    },
    {
      "name": "Create Visual Workflow (POST /api/workflows)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Turbine Overheat Protection\",\n  \"description\": \"Trigger SMS when turbine sensor exceeds 85°C\",\n  \"status\": \"active\",\n  \"nodes\": [\n    {\n      \"id\": \"node_temp_01\",\n      \"type\": \"dataSource\",\n      \"label\": \"Turbine Sensor\",\n      \"position\": { \"x\": 100, \"y\": 150 },\n      \"data\": { \"category\": \"Data Source\", \"color\": \"#0ea5e9\" },\n      \"config\": { \"sensorId\": \"turbine-sensor-01\", \"metric\": \"temperature\" }\n    },\n    {\n      \"id\": \"node_threshold_01\",\n      \"type\": \"math\",\n      \"label\": \"High Temp Threshold\",\n      \"position\": { \"x\": 380, \"y\": 150 },\n      \"data\": { \"category\": \"Math Operation\", \"color\": \"#8b5cf6\" },\n      \"config\": { \"operator\": \">\", \"threshold\": 85.0 }\n    },\n    {\n      \"id\": \"node_sms_01\",\n      \"type\": \"action\",\n      \"label\": \"Emergency SMS Alert\",\n      \"position\": { \"x\": 660, \"y\": 150 },\n      \"data\": { \"category\": \"Action Trigger\", \"color\": \"#ef4444\" },\n      \"config\": { \"recipient\": \"+15550199\", \"message\": \"CRITICAL: Turbine Temperature > 85°C\" }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"edge_temp_thresh\",\n      \"source\": \"node_temp_01\",\n      \"target\": \"node_threshold_01\",\n      \"sourceHandle\": \"right\",\n      \"targetHandle\": \"left\",\n      \"animated\": true\n    },\n    {\n      \"id\": \"edge_thresh_sms\",\n      \"source\": \"node_threshold_01\",\n      \"target\": \"node_sms_01\",\n      \"sourceHandle\": \"right\",\n      \"targetHandle\": \"left\",\n      \"animated\": true\n    }\n  ],\n  \"metadata\": { \"department\": \"Plant Maintenance\" }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflows",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows"]
        }
      }
    },
    {
      "name": "List Workflows (GET /api/workflows)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/workflows?status=active",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows"],
          "query": [
            { "key": "status", "value": "active" }
          ]
        }
      }
    },
    {
      "name": "Get Workflow By ID (GET /api/workflows/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "{{workflowId}}"]
        }
      }
    },
    {
      "name": "Update Workflow (PUT /api/workflows/:id)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Turbine Overheat Protection (Production v2)\",\n  \"status\": \"active\",\n  \"nodes\": [\n    {\n      \"id\": \"node_temp_01\",\n      \"type\": \"dataSource\",\n      \"position\": { \"x\": 100, \"y\": 150 },\n      \"config\": { \"sensorId\": \"turbine-sensor-01\" }\n    },\n    {\n      \"id\": \"node_threshold_01\",\n      \"type\": \"math\",\n      \"position\": { \"x\": 380, \"y\": 150 },\n      \"config\": { \"operator\": \">\", \"threshold\": 90.0 }\n    },\n    {\n      \"id\": \"node_sms_01\",\n      \"type\": \"action\",\n      \"position\": { \"x\": 660, \"y\": 150 },\n      \"config\": { \"recipient\": \"+15550199\" }\n    }\n  ],\n  \"edges\": [\n    { \"source\": \"node_temp_01\", \"target\": \"node_threshold_01\" },\n    { \"source\": \"node_threshold_01\", \"target\": \"node_sms_01\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "{{workflowId}}"]
        }
      }
    },
    {
      "name": "Delete Workflow (DELETE /api/workflows/:id)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/workflows/{{workflowId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "{{workflowId}}"]
        }
      }
    },
    {
      "name": "Validate Workflow Graph (POST /api/workflows/validate)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nodes\": [\n    {\n      \"id\": \"node_temp_01\",\n      \"type\": \"temperatureSensor\",\n      \"position\": { \"x\": 100, \"y\": 150 },\n      \"config\": { \"sensorId\": \"turbine-sensor-01\" }\n    },\n    {\n      \"id\": \"node_threshold_01\",\n      \"type\": \"threshold\",\n      \"position\": { \"x\": 380, \"y\": 150 },\n      \"config\": { \"operator\": \">\", \"threshold\": 85.0 }\n    },\n    {\n      \"id\": \"node_sms_01\",\n      \"type\": \"smsAlert\",\n      \"position\": { \"x\": 660, \"y\": 150 },\n      \"config\": { \"recipient\": \"+15550199\", \"message\": \"Temp critical\" }\n    }\n  ],\n  \"edges\": [\n    { \"source\": \"node_temp_01\", \"target\": \"node_threshold_01\" },\n    { \"source\": \"node_threshold_01\", \"target\": \"node_sms_01\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflows/validate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "validate"]
        }
      }
    },
    {
      "name": "Validate Saved Workflow by ID (GET /api/workflows/:id/validate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/workflows/{{workflowId}}/validate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "{{workflowId}}", "validate"]
        }
      }
    },
    {
      "name": "Validate Workflow with Cycle (POST /api/workflows/validate - 400 Expected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nodes\": [\n    { \"id\": \"s1\", \"type\": \"dataSource\", \"config\": { \"sensorId\": \"s-01\" } },\n    { \"id\": \"m1\", \"type\": \"threshold\", \"config\": { \"operator\": \">\", \"threshold\": 50 } },\n    { \"id\": \"m2\", \"type\": \"threshold\", \"config\": { \"operator\": \"<\", \"threshold\": 10 } },\n    { \"id\": \"a1\", \"type\": \"smsAlert\", \"config\": { \"recipient\": \"+1555\" } }\n  ],\n  \"edges\": [\n    { \"source\": \"s1\", \"target\": \"m1\" },\n    { \"source\": \"m1\", \"target\": \"m2\" },\n    { \"source\": \"m2\", \"target\": \"m1\" },\n    { \"source\": \"m2\", \"target\": \"a1\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflows/validate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "workflows", "validate"]
        }
      }
    }
  ]
}
